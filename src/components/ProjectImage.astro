---
interface Props {
	src: string;
	alt?: string;
	width?: number;
	class?: string;
}

const { src, alt = '', width, class: imageClass } = Astro.props;
const themeSuffix = /_(Dark|Light)(?=\.[^/.]+$)/;
const themed = src.startsWith('/assets/') && themeSuffix.test(src);
const darkSrc = themed ? src.replace(themeSuffix, '_Dark') : src;
const lightSrc = themed ? src.replace(themeSuffix, '_Light') : undefined;
---

<picture>
	{lightSrc && <source srcset={lightSrc} media="(prefers-color-scheme: light)" data-project-light />}
	<img src={darkSrc} alt={alt} width={width} class:list={['project-img', imageClass]} />
</picture>

<script>
	function updateProjectImages() {
		const isDark = document.documentElement.classList.contains('theme-dark');
		document.querySelectorAll<HTMLSourceElement>('source[data-project-light]').forEach((source) => {
			source.media = isDark ? 'not all' : 'all';
		});
	}

	new MutationObserver(updateProjectImages).observe(document.documentElement, {
		attributeFilter: ['class'],
	});

	updateProjectImages();
</script>
