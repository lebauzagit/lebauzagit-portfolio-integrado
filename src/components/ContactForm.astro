---
// Contact form component for collaboration requests
import { getLangFromUrl, useTranslations } from '../i18n/utils';

import brand from '../config/brand.json';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="contact-form-section">
	<form
		target="_blank"
		action={brand.contact.formEndpoint}
		method="POST"
        class="contact-form"
	>
		<div class="form-group">
			<div class="form-row">
				<div class="col">
                    <label for="name">{t('contact.name')} <span class="required">*</span></label>
					<input
						type="text"
						id="name" name="name"
						class="form-control"
						placeholder={t('contact.placeholder.name')}
						required
					/>
				</div>
				<div class="col">
                    <label for="email">{t('contact.email')} <span class="required">*</span></label>
					<input
						type="email"
						id="email" name="email"
						class="form-control"
						placeholder={t('contact.placeholder.email')}
						required
					/>
				</div>
			</div>
		</div>
		<div class="form-group">
            <label for="message">{t('contact.message')} <span class="required">*</span></label>
			<textarea
				placeholder={t('contact.placeholder.message')}
				class="form-control"
				id="message" name="message"
				rows="10"
				required></textarea>
		</div>
		<p class="privacy-note">{lang === 'es' ? 'El formulario utiliza FormSubmit para enviar tu mensaje. No incluyas información sensible.' : 'This form uses FormSubmit to deliver your message. Do not include sensitive information.'}</p>
 <button type="submit" class="submit-btn"
			>{t('contact.send')}</button
		>
	</form>
</section>


<style>
	.contact-form-section {
		width: 50%;
	}

	.contact-container {
		max-width: 700px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.contact-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.contact-header h2 {
		font-size: var(--text-3xl);
		color: var(--gray-0);
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.contact-header p {
		font-size: var(--text-md);
		color: var(--gray-300);
		line-height: 1.6;
	}

	.contact-form {
		background: var(--gradient-subtle);
		padding: 2.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	@media (min-width: 50em) {
		.form-row {
			grid-template-columns: 1fr 1fr;
		}
	}

	.form-group {
		margin-bottom: 1.5rem;
	}

	.form-group label {
		display: block;
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--gray-200);
		margin-bottom: 0.5rem;
	}

	.required {
		color: var(--accent-regular);
	}

	.form-group input,
	.form-group textarea {
		width: 100%;
		padding: 0.875rem 1rem;
		font-size: var(--text-base);
		font-family: var(--font-body);
		color: var(--gray-0);
		background: var(--gray-999);
		border: 1px solid var(--gray-800);
		border-radius: 0.5rem;
		transition: all 0.2s ease;
	}

	.form-group input:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--accent-regular);
		box-shadow: 0 0 0 3px var(--accent-overlay);
	}

	.form-group input::placeholder,
	.form-group textarea::placeholder {
		color: var(--gray-400);
	}

	.form-group textarea {
		resize: vertical;
		min-height: 120px;
	}

	.checkbox-group {
		margin-bottom: 2rem;
	}

	.checkbox-label {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		cursor: pointer;
		font-size: var(--text-sm);
		color: var(--gray-300);
	}

	.checkbox-label input[type='checkbox'] {
		width: auto;
		margin-top: 0.25rem;
		cursor: pointer;
		accent-color: var(--accent-regular);
	}

	.submit-btn {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 1rem 2rem;
		font-size: var(--text-md);
		font-weight: 600;
		color: var(--accent-text-over);
		background: var(--gradient-accent);
		border: none;
		border-radius: 0.75rem;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
		box-shadow: var(--shadow-md);
	}

	.submit-btn:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-lg);
	}

	.submit-btn:active {
		transform: translateY(0);
	}

	.submit-btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
		transform: none;
	}

	.btn-icon {
		font-size: 1.5rem;
		transition: transform 0.2s ease;
	}

	.submit-btn:hover .btn-icon {
		transform: translateX(4px);
	}

	.form-status {
		margin-top: 1.5rem;
		padding: 1rem;
		border-radius: 0.5rem;
		text-align: center;
		font-size: var(--text-sm);
		font-weight: 500;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.form-status.success,
	.form-status.error {
		opacity: 1;
	}

	.form-status.success {
		background: rgba(34, 197, 94, 0.1);
		color: #22c55e;
		border: 1px solid rgba(34, 197, 94, 0.3);
	}

	.form-status.error {
		background: rgba(239, 68, 68, 0.1);
		color: #ef4444;
		border: 1px solid rgba(239, 68, 68, 0.3);
	}

	@media (min-width: 50em) {
		.contact-form {
			padding: 3rem;
		}

		.contact-header h2 {
			font-size: var(--text-4xl);
		}
	}
</style>
